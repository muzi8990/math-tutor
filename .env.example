GOOGLE_API_KEY=replace-with-your-key
# Preserves the original project's default; set an available model for your account.
GEMINI_MODEL=gemini-2.5-flash
# Optional grade: 1-6 primary, 7-9 middle, 10-12 high school; leave unset if unknown.
# TUTOR_GRADE=3
TUTOR_MAX_TURNS=30
TUTOR_TIMEOUT_MS=60000
TUTOR_TEMPERATURE=0.1
TUTOR_MAX_OUTPUT_TOKENS=4096
TUTOR_SERVICE_MAX_SESSIONS=100
TUTOR_LOG_LEVEL=INFO
TUTOR_LOG_FILE=logs/math-tutor.log

# Persistent mistake notebook (paths are relative to the working directory).
TUTOR_DATABASE_PATH=data/mistakes.sqlite3
TUTOR_ASSET_DIR=data/assets
TUTOR_STUDENT_TIMEZONE=Asia/Shanghai
TUTOR_REVIEW_INTERVALS=[1,3,7]
TUTOR_WORKER_CONCURRENCY=1
TUTOR_JOB_LEASE_SECONDS=180
# Local testing only. Both settings are required; authentication remains off by default.
TUTOR_ENABLE_LOCAL_IDENTITY=false
# TUTOR_LOCAL_STUDENT_ID=11111111-1111-4111-8111-111111111111

# 结构化分析质量检查：off / on_risk / always；修复次数仅允许 0 或 1
TUTOR_QUALITY_MODEL_REVIEW=on_risk
TUTOR_QUALITY_MAX_REPAIRS=1
